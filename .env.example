# ================================================================
# إعدادات نظام OCR-PCCompta
# انسخ هذا الملف إلى .env وعدّل القيم
# ================================================================

# === محرك OCR ===
# textract | google_vision | tesseract
OCR_ENGINE=textract

# === Amazon Textract ===
AWS_REGION=eu-west-1
AWS_ACCESS_KEY_ID=your_access_key_here
AWS_SECRET_ACCESS_KEY=your_secret_key_here
AWS_S3_BUCKET=your_bucket_name

# === Google Document AI ===
GOOGLE_APPLICATION_CREDENTIALS=/path/to/credentials.json
GOOGLE_PROJECT_ID=your_project_id
GOOGLE_PROCESSOR_ID=your_processor_id

# === Tesseract ===
TESSERACT_CMD=/usr/bin/tesseract
TESSERACT_LANG=ara+fra+eng

# === مسارات الملفات ===
INPUT_DIR=data/input
OUTPUT_DIR=data/output
PCCOMPTA_IMPORT_DIR=C:/PCCompta/Import

# === إعدادات التحقق ===
# نسبة ثقة الاستيراد التلقائي (0.95 = 95%)
CONFIDENCE_THRESHOLD_AUTO=0.95
# نسبة ثقة المراجعة اليدوية (ما دونها = إدخال يدوي)
CONFIDENCE_THRESHOLD_REVIEW=0.60
# الفارق المقبول في التحقق الحسابي (دينار)
AMOUNT_TOLERANCE=0.02

# === التسجيل ===
LOG_LEVEL=INFO
